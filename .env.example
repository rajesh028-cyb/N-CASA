# N-CASA Environment Variables — Example Template
# Copy this file to .env and adjust variables as required.
# DO NOT COMMIT SECRETS TO GIT.

# Database Configuration (Block 11)
DATABASE_URL=postgresql+asyncpg://postgres:<PASSWORD>@localhost:5432/n_casa
TEST_DATABASE_URL=postgresql+asyncpg://postgres:<PASSWORD>@localhost:5432/n_casa_test

# AI Configuration (Block 10)
AI_ENABLED=false
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_BASE_URL=
AI_TIMEOUT_SECONDS=60
